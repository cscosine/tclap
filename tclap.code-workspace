{
  "folders": [
    {
      "path": "."
    }
  ],
  "settings": {
    // Tell CMake Tools to use the default preset
    "cmake.useCMakePresets": "always",
    "cmake.configurePreset": "linux-ninja-release",
    "cmake.buildPreset": "linux-ninja-release",

    // IntelliSense via compile_commands.json
    "C_Cpp.default.compileCommands": "${workspaceFolder}/../build/linux-ninja/tclap/release/compile_commands.json",
    "C_Cpp.intelliSenseEngine": "disabled",

    // Optional: CMake Tools logging
    "cmake.loggingLevel": "info",

    "clangd.arguments": ["-log=verbose",
                         "-pretty",
                         "--background-index",
                         "--compile-commands-dir=${workspaceFolder}/../build/linux-ninja/tclap/release"]
  }
}
